# Образец. Скопируйте в .env.local и впишите свой ключ.
#
#   copy .env.local.example .env.local
#
# .env.local уже в .gitignore — в репозиторий не попадёт.
# Заполняется только один блок, тот, которым пользуетесь.

# --- Вариант 1: AgentPlatform или другой OpenAI-совместимый прокси ---
# Ключ: https://app.agentplatform.ru/api-keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.agentplatform.ru/v1

# --- Вариант 2: прямой OpenAI ---
# Ключ: https://platform.openai.com/api-keys
# Тот же OPENAI_API_KEY, но адрес по умолчанию:
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Вариант 3: прямой Google Gemini ---
# Ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
